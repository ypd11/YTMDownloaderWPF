<Window x:Class="YTMDownloaderWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="YTM Downloader"
        Width="1200"
        Height="780"
        MinWidth="1000"
        MinHeight="650"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#0D0F12"
        Foreground="#F1F3F5"
        FontFamily="Segoe UI"
        UseLayoutRounding="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42"
                            ResizeBorderThickness="6"
                            CornerRadius="10"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>

        <!-- Colors -->
        <SolidColorBrush x:Key="BackgroundBrush" Color="#0D0F12"/>
        <SolidColorBrush x:Key="SidebarBrush" Color="#111418"/>
        <SolidColorBrush x:Key="CardBrush" Color="#181C21"/>
        <SolidColorBrush x:Key="InputBrush" Color="#22272E"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#292F37"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#10B981"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#8B949E"/>

        <!-- General Button -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#10B981"/>
            <Setter Property="Foreground" Value="#07130F"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#34D399"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sidebar Navigation -->
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#9CA3AF"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="15,12"/>
            <Setter Property="Margin" Value="0,3,0,3"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="NavBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavBorder"
                                        Property="Background"
                                        Value="#22272E"/>
                                <Setter Property="Foreground"
                                        Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="NavBorder"
                                        Property="Opacity"
                                        Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Window Controls -->
        <Style x:Key="WindowButton" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#A1A1AA"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome"
                    Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="WindowButtonBorder"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="WindowButtonBorder"
                                        Property="Background"
                                        Value="#292F37"/>
                                <Setter Property="Foreground"
                                        Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseButton"
               TargetType="Button"
               BasedOn="{StaticResource WindowButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CloseBorder"
                                Background="Transparent">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CloseBorder"
                                        Property="Background"
                                        Value="#E81123"/>
                                <Setter Property="Foreground"
                                        Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TextBox -->
        <Style x:Key="UrlTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#22272E"/>
            <Setter Property="Foreground" Value="#F1F3F5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="CaretBrush" Value="#10B981"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

    </Window.Resources>

    <Border Background="{StaticResource BackgroundBrush}"
            CornerRadius="10"
            BorderBrush="#252A31"
            BorderThickness="1">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Custom Title Bar -->
            <Grid Grid.Row="0"
                  Background="#111418">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="18,0">

                    <Border Width="25"
                            Height="25"
                            Background="#10B981"
                            CornerRadius="7"
                            Margin="0,0,10,0">

                        <TextBlock Text="♫"
                                   Foreground="#07130F"
                                   FontSize="17"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <TextBlock Text="YTM Downloader"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#E5E7EB"
                               VerticalAlignment="Center"/>

                    <TextBlock Text="  /  Personal Edition"
                               FontSize="12"
                               Foreground="#6B7280"
                               VerticalAlignment="Center"/>

                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal">

                    <Button Style="{StaticResource WindowButton}"
                            Content="&#xE921;"
                            FontFamily="Segoe MDL2 Assets"
                            Click="MinimizeButton_Click"/>

                    <Button x:Name="MaximizeButton"
                            Style="{StaticResource WindowButton}"
                            Content="&#xE922;"
                            FontFamily="Segoe MDL2 Assets"
                            Click="MaximizeButton_Click"/>

                    <Button Style="{StaticResource CloseButton}"
                            Content="&#xE8BB;"
                            FontFamily="Segoe MDL2 Assets"
                            Click="CloseButton_Click"/>

                </StackPanel>

            </Grid>

            <!-- Main Layout -->
            <Grid Grid.Row="1">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Sidebar -->
                <Border Grid.Column="0"
                        Background="{StaticResource SidebarBrush}"
                        BorderBrush="#252A31"
                        BorderThickness="0,0,1,0">

                    <Grid Margin="16,20,16,16">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0"
                                    Margin="5,0,0,24">

                            <TextBlock Text="YOUR MUSIC"
           FontSize="10"
           FontWeight="Bold"
           Foreground="#59616D"/>

                        </StackPanel>

                        <StackPanel Grid.Row="1">

                            <Button Style="{StaticResource NavButton}"
                                    Background="#19382E"
                                    Foreground="#10B981">

                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE896;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="16"
                                               Margin="0,0,13,0"/>
                                    <TextBlock Text="Download"/>
                                </StackPanel>

                            </Button>

                            <Button Style="{StaticResource NavButton}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8B7;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="16"
                                               Margin="0,0,13,0"/>
                                    <TextBlock Text="Music Library"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource NavButton}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE823;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="16"
                                               Margin="0,0,13,0"/>
                                    <TextBlock Text="Download Queue"/>
                                </StackPanel>
                            </Button>

                        </StackPanel>

                        <StackPanel Grid.Row="3">

                            <Border Height="1"
                                    Background="#252A31"
                                    Margin="0,0,0,14"/>

                            <Button x:Name="SettingsNavButton"
                                    Style="{StaticResource NavButton}"
                                    Click="SettingsNavButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE713;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="16"
                                               Margin="0,0,13,0"/>
                                    <TextBlock Text="Settings"/>
                                </StackPanel>
                            </Button>

                            <TextBlock Text="YTM Downloader  ·  v1.0"
                                       FontSize="10"
                                       Foreground="#59616D"
                                       Margin="14,12,0,0"/>

                        </StackPanel>

                    </Grid>

                </Border>

                <!-- Main Content -->
                <Grid Grid.Column="1"
                      Margin="30,26,30,24">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Page Header -->
                    <Grid Grid.Row="0"
                          Margin="0,0,0,24">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="Download Music"
                                       FontSize="26"
                                       FontWeight="Bold"
                                       Foreground="#F9FAFB"/>

                            <TextBlock Text="Turn your favorite playlists into a music collection."
                                       FontSize="13"
                                       Foreground="#8B949E"
                                       Margin="0,7,0,0"/>
                        </StackPanel>

                        <Border Grid.Column="1"
                                Background="#19382E"
                                CornerRadius="8"
                                Padding="12,8"
                                VerticalAlignment="Center">

                            <StackPanel Orientation="Horizontal">

                                <Ellipse Width="7"
                                         Height="7"
                                         Fill="#10B981"
                                         Margin="0,0,8,0"/>

                                <TextBlock Text="Ready"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="#10B981"/>

                            </StackPanel>

                        </Border>

                    </Grid>

                    <!-- URL Input Card -->
                    <Border Grid.Row="1"
                            Background="{StaticResource CardBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="20"
                            Margin="0,0,0,22">

                        <Grid>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0"
                                        Margin="0,0,0,14">

                                <TextBlock Text="Playlist URL"
                                           FontSize="14"
                                           FontWeight="SemiBold"/>

                                <TextBlock Text="Paste a YouTube Music playlist link to get started."
                                           FontSize="12"
                                           Foreground="#8B949E"
                                           Margin="0,5,0,0"/>

                            </StackPanel>

                            <Grid Grid.Row="1">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Background="{StaticResource InputBrush}"
                                        CornerRadius="8"
                                        Margin="0,0,12,0">

                                    <TextBox x:Name="PlaylistUrlTextBox"
                                             Style="{StaticResource UrlTextBox}"
                                             Background="Transparent"
                                             Text=""/>

                                </Border>

                                <Button x:Name="AnalyzeButton"
                                        Grid.Column="1"                                        
                                        Style="{StaticResource ActionButton}"
                                        Click="AnalyzeButton_Click">

                                    <StackPanel Orientation="Horizontal">

                                        <TextBlock Text="&#xE721;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="13"
                                                   Margin="0,0,9,0"/>

                                        <TextBlock Text="Analyze Playlist"/>

                                    </StackPanel>

                                </Button>

                            </Grid>

                        </Grid>

                    </Border>

                    <!-- Playlist Preview -->
                    <Border Grid.Row="2"
                            Background="{StaticResource CardBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="20">

                        <Grid>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0"
                                  Margin="0,0,0,18">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock x:Name="PlaylistPreviewTitle"
           Text="Playlist Preview"
           FontSize="15"
           FontWeight="SemiBold"/>

                                    <TextBlock x:Name="PlaylistPreviewSubtitle"
           Text="Your tracks will appear here after analysis."
           FontSize="12"
           Foreground="#8B949E"
           Margin="0,5,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1"
            Orientation="Horizontal"
            VerticalAlignment="Center">

                                    <TextBlock x:Name="TrackCountText"
               Text="0 TRACKS"
               FontSize="11"
               FontWeight="SemiBold"
               Foreground="#6B7280"
               VerticalAlignment="Center"
               Margin="0,0,16,0"/>

                                    <Button x:Name="DownloadButton"
            Style="{StaticResource ActionButton}"
            Content="Download Playlist"
            IsEnabled="False"
            Click="DownloadButton_Click"/>

                                    <Button x:Name="PauseDownloadButton"
        Style="{StaticResource ActionButton}"
        Content="Pause"
        Background="#29313A"
        Foreground="#F1F3F5"
        Margin="10,0,0,0"
        IsEnabled="False"
        Visibility="Collapsed"
        Click="PauseDownloadButton_Click"/>

                                    <Button x:Name="CancelDownloadButton"
        Style="{StaticResource ActionButton}"
        Content="Cancel"
        Background="#3A2024"
        Foreground="#FCA5A5"
        Margin="10,0,0,0"
        IsEnabled="False"
        Visibility="Collapsed"
        Click="CancelDownloadButton_Click"/>

                                </StackPanel>

                            </Grid>

                            <!-- Playlist Content -->
                            <Grid Grid.Row="1">

                                <!-- Empty State -->
                                <StackPanel x:Name="PlaylistEmptyState"
                VerticalAlignment="Center"
                HorizontalAlignment="Center">

                                    <Border Width="78"
                Height="78"
                Background="#22272E"
                CornerRadius="20"
                HorizontalAlignment="Center"
                Margin="0,0,0,20">

                                        <TextBlock Text="&#xE8D6;"
                       FontFamily="Segoe MDL2 Assets"
                       FontSize="30"
                       Foreground="#59616D"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>

                                    </Border>

                                    <TextBlock Text="Nothing here yet"
                   FontSize="16"
                   FontWeight="SemiBold"
                   HorizontalAlignment="Center"/>

                                    <TextBlock Text="Paste a playlist link above and analyze it."
                   FontSize="12"
                   Foreground="#8B949E"
                   Margin="0,8,0,0"
                   HorizontalAlignment="Center"/>

                                </StackPanel>

                                <!-- Track List -->
                                <ListBox x:Name="PlaylistTracksList"
             Visibility="Collapsed"
             Background="Transparent"
             BorderThickness="0"
             ScrollViewer.VerticalScrollBarVisibility="Auto"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Margin" Value="0,0,0,8"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Focusable" Value="False"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border x:Name="TrackBorder"
                                    Background="Transparent"
                                    CornerRadius="8"
                                    Padding="8">

                                                            <ContentPresenter/>

                                                        </Border>

                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="TrackBorder"
                                            Property="Background"
                                            Value="#22272E"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>

                                    <ListBox.ItemTemplate>
                                        <DataTemplate>

                                            <Grid Height="58">

                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="35"/>
                                                    <ColumnDefinition Width="54"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="75"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Track Number -->
                                                <TextBlock Grid.Column="0"
                               Text="{Binding PlaylistIndex}"
                               Foreground="#6B7280"
                               FontSize="12"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"/>

                                                <!-- Thumbnail -->
                                                <Border Grid.Column="1"
                            Width="46"
                            Height="46"
                            CornerRadius="6"
                            Background="#292F37"
                            ClipToBounds="True">

                                                    <Image Source="{Binding ThumbnailUrl}"
                               Stretch="UniformToFill"/>

                                                </Border>

                                                <!-- Track Information -->
                                                <StackPanel Grid.Column="2"
                                VerticalAlignment="Center"
                                Margin="12,0,8,0">

                                                    <TextBlock Text="{Binding Title}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#F1F3F5"
                                   TextTrimming="CharacterEllipsis"/>

                                                    <TextBlock Text="{Binding Artist}"
                                   FontSize="11"
                                   Foreground="#8B949E"
                                   Margin="0,4,0,0"
                                   TextTrimming="CharacterEllipsis"/>

                                                </StackPanel>

                                                <!-- Duration -->
                                                <TextBlock Grid.Column="3"
                               Text="{Binding Duration}"
                               FontSize="11"
                               Foreground="#8B949E"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right"
                               Margin="0,0,8,0"/>

                                            </Grid>

                                        </DataTemplate>
                                    </ListBox.ItemTemplate>

                                </ListBox>

                            </Grid>

                        </Grid>

                    </Border>

                    <!-- Bottom Status and Download Progress -->
                    <Grid Grid.Row="3"
      Margin="0,18,0,0">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal"
                    VerticalAlignment="Center">

                                <TextBlock Text="&#xE895;"
                       FontFamily="Segoe MDL2 Assets"
                       FontSize="13"
                       Foreground="#10B981"
                       Margin="0,0,8,0"/>

                                <TextBlock Text="MP3"
                       FontSize="12"
                       FontWeight="SemiBold"/>

                                <TextBlock Text="  ·  320 kbps  ·  Embedded artwork"
                       FontSize="12"
                       Foreground="#8B949E"/>

                            </StackPanel>

                            <TextBlock x:Name="DownloadStatusText"
                   Grid.Column="1"
                   Text="Ready to download"
                   FontSize="12"
                   Foreground="#6B7280"
                   VerticalAlignment="Center"/>
                        </Grid>

                        <ProgressBar x:Name="DownloadProgressBar"
                 Grid.Row="1"
                 Height="5"
                 Margin="0,12,0,0"
                 Minimum="0"
                 Maximum="100"
                 Value="0"
                 Visibility="Collapsed"
                 Background="#292F37"
                 Foreground="#10B981"
                 BorderThickness="0"/>

                    </Grid>

                </Grid>

            </Grid>

        </Grid>

    </Border>

</Window>
