<Window x:Class="YTMDownloaderWPF.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Width="560"
        Height="540"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="#0D0F12"
        Foreground="#F1F3F5"
        FontFamily="Segoe UI">

    <Border Background="#111418"
            BorderBrush="#292F37"
            BorderThickness="1"
            CornerRadius="10">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="64"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Grid Grid.Row="0"
                  Background="#181C21">

                <TextBlock Text="Settings"
                           FontSize="14"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="20,0"/>

                <Button Content="&#xE8BB;"
                        FontFamily="Segoe MDL2 Assets"
                        Width="46"
                        Height="46"
                        HorizontalAlignment="Right"
                        Background="Transparent"
                        Foreground="#A1A1AA"
                        BorderThickness="0"
                        Click="CloseButton_Click"/>
            </Grid>

            <!-- Settings Content -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">

                <StackPanel Margin="24">

                    <TextBlock Text="Download Settings"
                               FontSize="21"
                               FontWeight="Bold"/>

                    <TextBlock Text="Customize where and how your music is downloaded."
                               FontSize="12"
                               Foreground="#8B949E"
                               Margin="0,6,0,24"/>

                    <!-- Output Folder -->
                    <StackPanel Margin="0,0,0,20">

                        <TextBlock Text="Download Location"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,10"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="OutputFolderTextBox"
                                     Grid.Column="0"
                                     Height="40"
                                     Background="#22272E"
                                     Foreground="#F1F3F5"
                                     BorderThickness="0"
                                     Padding="12,10"
                                     VerticalContentAlignment="Center"
                                     IsReadOnly="True"/>

                            <Button x:Name="BrowseFolderButton"
                                    Grid.Column="1"
                                    Content="Browse"
                                    Margin="10,0,0,0"
                                    Padding="18,0"
                                    Height="40"
                                    Background="#10B981"
                                    Foreground="#07130F"
                                    FontWeight="SemiBold"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Click="BrowseFolderButton_Click"/>
                        </Grid>
                    </StackPanel>

                    <!-- Audio Format -->
                    <StackPanel Margin="0,0,0,20">

                        <TextBlock Text="Audio Format"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8"/>

                        <ComboBox x:Name="AudioFormatComboBox"
                                  Height="40"
                                  Background="#22272E"
                                  Foreground="#F1F3F5"
                                  BorderBrush="#292F37"
                                  Padding="10,5"
                                  SelectedIndex="0">

                            <ComboBoxItem Content="MP3"/>
                            <ComboBoxItem Content="M4A"/>
                            <ComboBoxItem Content="WAV"/>
                            <ComboBoxItem Content="FLAC"/>

                        </ComboBox>
                    </StackPanel>

                    <!-- Audio Quality -->
                    <StackPanel Margin="0,0,0,20">

                        <TextBlock Text="Audio Quality"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8"/>

                        <ComboBox x:Name="AudioQualityComboBox"
                                  Height="40"
                                  Background="#22272E"
                                  Foreground="#F1F3F5"
                                  BorderBrush="#292F37"
                                  Padding="10,5"
                                  SelectedIndex="0">

                            <ComboBoxItem Content="320K"/>
                            <ComboBoxItem Content="256K"/>
                            <ComboBoxItem Content="192K"/>
                            <ComboBoxItem Content="128K"/>

                        </ComboBox>
                    </StackPanel>

                    <!-- Metadata Options -->
                    <StackPanel Margin="0,0,0,20">

                        <TextBlock Text="Metadata"
               FontSize="13"
               FontWeight="SemiBold"
               Margin="0,0,0,12"/>

                        <CheckBox x:Name="EmbedThumbnailCheckBox"
              Content="Embed album artwork"
              Foreground="#F1F3F5"
              FontSize="13"
              Margin="0,0,0,12"/>

                        <CheckBox x:Name="AddMetadataCheckBox"
              Content="Add song metadata"
              Foreground="#F1F3F5"
              FontSize="13"/>

                    </StackPanel>

                </StackPanel>
            </ScrollViewer>

            <!-- Bottom Buttons -->
            <Border Grid.Row="2"
                    Background="#181C21"
                    BorderBrush="#292F37"
                    BorderThickness="0,1,0,0">

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="20,0">

                    <Button Content="Cancel"
                            Width="90"
                            Height="36"
                            Margin="0,0,10,0"
                            Background="#22272E"
                            Foreground="#F1F3F5"
                            BorderThickness="0"
                            Click="CancelSettingsButton_Click"/>

                    <Button x:Name="SaveSettingsButton"
                            Content="Save Changes"
                            Width="120"
                            Height="36"
                            Background="#10B981"
                            Foreground="#07130F"
                            FontWeight="SemiBold"
                            BorderThickness="0"
                            Click="SaveSettingsButton_Click"/>

                </StackPanel>
            </Border>

        </Grid>
    </Border>
</Window>
